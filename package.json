{
  "name": "eda-copilot-backend",
  "version": "0.4.0",
  "description": "Component search, schematic layout and PCB placement for EDA Copilot integrations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biosshot/eda-copilot-backend.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./schematic": {
      "types": "./dist/schematic.d.ts",
      "import": "./dist/schematic.js"
    },
    "./pcb": {
      "types": "./dist/pcb.d.ts",
      "import": "./dist/pcb.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#*": "./src/*"
  },
  "files": [
    "dist",
    "native/pcb-board-packer/*.node",
    "native/pcb-board-packer/*.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "native:build": "node scripts/build-native.mjs",
    "test": "node scripts/test.mjs",
    "test:pcb": "node scripts/test.mjs pcb-",
    "test:recovery": "node --import tsx --test --test-concurrency=1 --test-name-pattern=\"failure|recovery|disabled|absent|allocation|empty|unsupported|runtime selection|driver|unavailable|do not initialize\" tests/pcb-block-gpu.test.ts tests/pcb-board-gpu.test.ts tests/pcb-post-place-refiner.test.ts",
    "test:pcb-layout": "node scripts/test-pcb-layout.mjs",
    "test:pcb-analyze": "node scripts/test-pcb-analyze.mjs",
    "debug:pcb-layout": "node --import tsx scripts/debug-pcb-layout.mjs",
    "debug:pcb-validation": "node --import tsx scripts/debug-pcb-validation.mjs",
    "test:schematics": "node scripts/test-schematic-layout.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "dev": "tsup --watch --onSuccess \"node scripts/copy-assets.mjs\"",
    "check:release": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@mr_mint/elkjs-libavoid": "0.5.0",
    "elkjs": "^0.11.1",
    "fetch-retry": "^6.0.0",
    "pino": "^10.3.1",
    "workerpool": "10.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "canvas": "^3.2.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/biosshot/eda-copilot-backend#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
